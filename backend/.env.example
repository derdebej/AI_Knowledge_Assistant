# Copy this file to .env and fill in real values. Never commit .env.
# See specs/DEVOPS.md §3 for the authoritative variable reference.

ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true

# --- Database (must match the docker-compose postgres service) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_assistant

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- OpenAI / RAG ---
OPENAI_API_KEY=sk-replace-with-your-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_MAX=10
RELEVANCE_THRESHOLD=0.75

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
UPLOAD_STORAGE_PATH=/data/uploads
ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".txt"]
