# Copy this file to .env and fill in real values. Never commit .env.
# See specs/DEVOPS.md §3 for the authoritative variable reference.

ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true

# --- Database (must match the docker-compose postgres service) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_assistant
# If port 5432 is already taken locally (e.g. a native Postgres install),
# set this to remap the container's host port and update DATABASE_URL to match.
# POSTGRES_HOST_PORT=5433

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- OpenAI / RAG ---
OPENAI_API_KEY=sk-replace-with-your-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Provider overrides (optional) ---
# Point generation and/or embeddings at a different OpenAI-compatible
# endpoint than OPENAI_API_KEY above - e.g. OpenRouter. Each is independent;
# leave either pair unset to keep that port on OpenAI. If you switch
# EMBEDDING_MODEL to a model with a different vector dimensionality, update
# EMBEDDING_DIMENSIONS to match and run a migration to resize the
# document_chunks.embedding column (see alembic/versions/ for an example).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-replace-with-your-openrouter-key
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=sk-or-v1-replace-with-your-openrouter-key

# --- Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_MAX=10
RELEVANCE_THRESHOLD=0.75

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
UPLOAD_STORAGE_PATH=/data/uploads
ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".txt"]
